# ====== Copy this file to ".env" and fill in your real values ======
# (.env is gitignored — never commit real keys. On Railway, set these as Variables.)

# Instantly API key — Instantly dashboard -> Integrations -> API Keys
INSTANTLY_API_KEY=

# OpenRouter (free model) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Telegram bot token (@BotFather) + your chat id (@userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vapi (for the auto-demo voice agent) — dashboard.vapi.ai
VAPI_PRIVATE_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_VOICE_ID=Elliot

# ====== Behavior ======
POLL_INTERVAL_MINUTES=5
AUTO_SEND=true
# AUTO_CALL: when an interested lead shares a phone number, auto-place the demo call.
# Set false to build the agent but NOT auto-dial (you place the call yourself).
AUTO_CALL=true
SIGNATURE_NAME=Bakhtiyor

# On Railway only: persist state across redeploys via a mounted volume
# STATE_FILE=/data/processed.json
