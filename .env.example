# ====== Copy this file to ".env" and fill in your real values ======
# (.env is gitignored — never commit real keys. On Railway, set these as Variables.)

# Instantly API key — Instantly dashboard -> Integrations -> API Keys
INSTANTLY_API_KEY=

# OpenRouter (free model) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Telegram bot token — from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram chat id — from @userinfobot (a number)
TELEGRAM_CHAT_ID=

# ====== Behavior ======
POLL_INTERVAL_MINUTES=5
AUTO_SEND=true
SIGNATURE_NAME=Bakhtiyor

# On Railway only: point state at a mounted volume so it survives redeploys
# STATE_FILE=/data/processed.json
